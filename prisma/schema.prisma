generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}



model User {
  id                 String   @id @default(cuid())
  name               String?
  username           String   @unique
  passwordHash       String
  recoveryPinHash    String?
  photoUrl           String?

  role               String   @default("STUDENT")
  isStoreUser        Boolean  @default(false)

  mustChangePassword Boolean  @default(true)
  onboardingCompleted Boolean  @default(false)
  isProfileVerified  Boolean  @default(false)
  isActive           Boolean  @default(true)
  activeToken        String?
  pushToken          String?
  createdAt          DateTime @default(now())
  
  studentProfile     StudentProfile?
  teacherProfile     TeacherProfile?
  payments           Payment[]
  sentMessages       Message[] @relation("SentMessages")
  receivedMessages   Message[] @relation("ReceivedMessages")
  createdGroups      ChatGroup[] @relation("CreatedGroups")
  groupMemberships   GroupMember[] @relation("GroupMemberships")

  // LMS Expansion Relations
  teacherBatches     Batch[]        @relation("TeacherBatches")
  studentBatches     Batch[]        @relation("StudentBatches")
  attendance         Attendance[]   @relation("StudentAttendance")
  testResults        TestResult[]   @relation("StudentTestResults")
  materials          Material[]
  notifications      Notification[]
  salaryRecords      SalaryRecord[]
  doubtHistory       DoubtHistory[]

  // E-commerce & Online Tests
  storePurchases        StorePurchase[]
  assignmentSubmissions AssignmentSubmission[]
  onlineTestSubmissions OnlineTestSubmission[]

  @@index([role])
  @@index([isActive])
}

model Message {
  id                String     @id @default(cuid())
  content           String
  senderId          String
  sender            User       @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId        String?
  receiver          User?      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  groupId           String?
  group             ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  isRead            Boolean    @default(false)
  deletedBySender   Boolean    @default(false)
  deletedByReceiver Boolean    @default(false)

  @@index([senderId])
  @@index([receiverId])
  @@index([groupId])
  @@index([createdAt])
  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([receiverId, isRead])
}

model ChatGroup {
  id          String        @id @default(cuid())
  name        String
  photoUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String
  createdBy   User          @relation("CreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  messages    Message[]
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  isAdmin   Boolean   @default(false)
  joinedAt  DateTime  @default(now())

  @@unique([groupId, userId])
}

model StudentProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber        String? @unique
  registrationNo    String?
  grade             String?
  className         String?
  board             String?
  scholarship       Float?  @default(0)
  batch             String?
  school            String?
  email             String?
  emailVerified     Boolean @default(false)
  phone             String?
  fatherName        String?
  parentContact     String?
  address           String?
  baseFee           Float?  @default(0)
  dob               String?
  photoUrl          String?
  attendancePercent Float?
  marksObtained     Float?
  marksTotal        Float?
  aadhaarNumber     String?
  gender            String?
  religion          String?

  @@index([className])
}

model TeacherProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject           String?
  email             String?
  emailVerified     Boolean @default(false)
  phone             String?
  address           String?
  dob               String?
  photoUrl          String?
  qualification     String?
  experience        String?
  salary            Float?  @default(0)
  gender            String?
  religion          String?
}

model Payment {
  id            String    @id @default(cuid())
  studentId     String
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title         String    @default("Monthly Fee")
  billingMonth  String
  dueDate       DateTime
  amount        Float     // Base amount
  discount      Float     @default(0)
  lateFine      Float     @default(0)
  paidAmount    Float?    @default(0)
  status        String    @default("PENDING")
  paymentMethod String?   // CASH, UPI, BANK, etc.
  transactionId String?
  remarks       String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  collectedBy   String?   // Admin who collected/verified the fee

  @@index([studentId])
  @@index([status])
  @@index([billingMonth])
  @@index([createdAt])
  @@index([paidAt])
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String   // SALARY, RENT, BILLS, OTHER
  amount      Float
  date        DateTime @default(now())
  remarks     String?
  createdAt   DateTime @default(now())

  @@index([date])
}

model Course {
  id          String       @id @default(cuid())
  name        String
  description String?
  batches     Batch[]
  materials   Material[]
  tests       Test[]
}

model Batch {
  id        String       @id @default(cuid())
  name      String
  className String?      // e.g. "10th"
  subjects  String?      // comma-separated or similar
  defaultFee Float?       @default(0)
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id])
  teachers  User[]       @relation("TeacherBatches")
  students  User[]       @relation("StudentBatches")
  schedules Schedule[]
  attendance Attendance[]
  lectures  Lecture[]

  @@index([courseId])
}

model Schedule {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0-6 (Sunday-Saturday)
  startTime String   // e.g., "10:00"
  endTime   String   // e.g., "11:30"
  room      String?
  subject   String?

  @@index([batchId])
}

model Material {
  id        String   @id @default(cuid())
  title     String
  type      String   // PDF, VIDEO, LINK
  url       String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  isAssignment Boolean @default(false)
  deadline     DateTime?
  submissions  AssignmentSubmission[]

  @@index([courseId])
  @@index([teacherId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId  String?
  title     String
  message   String
  type      String   // SYSTEM, FEE, ALERT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([senderId])
}

model Test {
  id          String       @id @default(cuid())
  title       String
  subject     String?
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id])
  date        DateTime
  time        String?
  syllabus    String?
  results     TestResult[]
  isPublished Boolean      @default(false)

  @@index([courseId])
}

model TestResult {
  id         String   @id @default(cuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation("StudentTestResults", fields: [studentId], references: [id], onDelete: Cascade)
  marks      Float
  totalMarks Float
  remarks    String?
  createdAt  DateTime @default(now())

  @@unique([testId, studentId])
  @@index([studentId])
}

model Attendance {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  status    String   // PRESENT, ABSENT, LATE
  
  @@unique([batchId, studentId, date])
  @@index([studentId, date])
}

model Lecture {
  id           String   @id @default(cuid())
  title        String
  description  String?
  youtubeUrl   String
  type         String   // LIVE or RECORDED
  subject      String
  batchId      String
  batch        Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assignedById String
  createdAt    DateTime @default(now())

  @@index([batchId])
}

model SalaryRecord {
  id            String   @id @default(cuid())
  teacherId     String
  teacher       User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  month         String   // e.g., "April 2026"
  baseSalary    Float
  bonus         Float    @default(0)
  deductions    Float    @default(0)
  netPaid       Float    @default(0)
  status        String   @default("PENDING") // PENDING, PAID
  paidAt        DateTime?
  transactionId String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([teacherId])
  @@index([status])
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AdmissionApplication {
  id           String   @id @default(cuid())
  appNumber    String   @unique
  name         String
  fatherName   String
  phone        String
  email        String?
  address      String
  className    String
  board        String
  program      String
  dob          String
  message      String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JobApplication {
  id          String   @id @default(cuid())
  appNumber   String   @unique
  name        String
  email       String
  phone       String
  position    String
  experience  String
  coverLetter String?
  resumeUrl   String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model DoubtHistory {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question   String   @db.Text
  subject    String?
  answer     String   @db.Text
  imageUrl   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([studentId])
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ------------------------------------------------------
// NEW MODELS: E-Commerce & Online Anti-Cheat Testing
// ------------------------------------------------------

model AssignmentSubmission {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  url        String   // PDF URL
  createdAt  DateTime @default(now())

  @@index([materialId])
  @@index([studentId])
}

model StoreItem {
  id          String   @id @default(cuid())
  title       String
  type        String   // TEST_SERIES, NOTES
  price       Float
  className   String?
  board       String?
  description String?
  fileUrl     String?  // for notes
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  purchases   StorePurchase[]
  onlineTests OnlineTest[]    // Relation if it's a test series
}

model StorePurchase {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  itemId      String
  item        StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  paymentId   String?   // Razorpay payment ID
  status      String    @default("PENDING") // SUCCESS, PENDING, FAILED
  amount      Float
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([itemId])
}

model OnlineTest {
  id              String   @id @default(cuid())
  title           String
  storeItemId     String
  storeItem       StoreItem @relation(fields: [storeItemId], references: [id], onDelete: Cascade)
  durationMinutes Int
  totalMarks      Float
  createdAt       DateTime @default(now())

  questions       OnlineTestQuestion[]
  submissions     OnlineTestSubmission[]
  
  @@index([storeItemId])
}

model OnlineTestQuestion {
  id            String   @id @default(cuid())
  onlineTestId  String
  onlineTest    OnlineTest @relation(fields: [onlineTestId], references: [id], onDelete: Cascade)
  questionText  String   @db.Text
  options       String   // JSON string of options array
  correctOption Int      // Index of correct option (0, 1, 2, 3)
  marks         Float    @default(1)
  explanation   String?  @db.Text

  @@index([onlineTestId])
}

model OnlineTestSubmission {
  id            String   @id @default(cuid())
  onlineTestId  String
  onlineTest    OnlineTest @relation(fields: [onlineTestId], references: [id], onDelete: Cascade)
  studentId     String
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score         Float
  timeTaken     Int      // seconds
  autoSubmitted Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([onlineTestId, studentId])
  @@index([studentId])
}
