generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}



model User {
  id                 String   @id @default(cuid())
  name               String?
  username           String   @unique
  passwordHash       String
  recoveryPinHash    String?
  photoUrl           String?

  role               String   @default("STUDENT")

  mustChangePassword Boolean  @default(true)
  onboardingCompleted Boolean  @default(false)
  isProfileVerified  Boolean  @default(false)
  isActive           Boolean  @default(true)
  activeToken        String?
  createdAt          DateTime @default(now())
  
  studentProfile     StudentProfile?
  teacherProfile     TeacherProfile?
  payments           Payment[]
  sentMessages       Message[] @relation("SentMessages")
  receivedMessages   Message[] @relation("ReceivedMessages")

  // LMS Expansion Relations
  teacherBatches     Batch[]        @relation("TeacherBatches")
  studentBatches     Batch[]        @relation("StudentBatches")
  attendance         Attendance[]   @relation("StudentAttendance")
  testResults        TestResult[]   @relation("StudentTestResults")
  materials          Material[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  salaryRecords      SalaryRecord[]
}

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  isRead     Boolean  @default(false)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model StudentProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber        String? @unique
  registrationNo    String?
  grade             String?
  className         String?
  batch             String?
  school            String?
  email             String?
  phone             String?
  fatherName        String?
  parentContact     String?
  address           String?
  baseFee           Float?  @default(0)
  dob               String?
  photoUrl          String?
  attendancePercent Float?
  marksObtained     Float?
  marksTotal        Float?
}

model TeacherProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject           String?
  email             String?
  phone             String?
  address           String?
  dob               String?
  photoUrl          String?
  qualification     String?
  experience        String?
  salary            Float?  @default(0)
}

model Payment {
  id            String    @id @default(cuid())
  studentId     String
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title         String    @default("Monthly Fee")
  billingMonth  String
  dueDate       DateTime
  amount        Float     // Base amount
  discount      Float     @default(0)
  lateFine      Float     @default(0)
  paidAmount    Float?    @default(0)
  status        String    @default("PENDING")
  paymentMethod String?   // CASH, UPI, BANK, etc.
  transactionId String?
  remarks       String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([studentId])
  @@index([status])
  @@index([billingMonth])
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String   // SALARY, RENT, BILLS, OTHER
  amount      Float
  date        DateTime @default(now())
  remarks     String?
  createdAt   DateTime @default(now())

  @@index([date])
}

model Course {
  id          String       @id @default(cuid())
  name        String
  description String?
  batches     Batch[]
  materials   Material[]
  tests       Test[]
}

model Batch {
  id        String       @id @default(cuid())
  name      String
  className String?      // e.g. "10th"
  subjects  String?      // comma-separated or similar
  defaultFee Float?       @default(0)
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id])
  teachers  User[]       @relation("TeacherBatches")
  students  User[]       @relation("StudentBatches")
  schedules Schedule[]
  attendance Attendance[]
  lectures  Lecture[]
}

model Schedule {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0-6 (Sunday-Saturday)
  startTime String   // e.g., "10:00"
  endTime   String   // e.g., "11:30"
  room      String?
  subject   String?

  @@index([batchId])
}

model Material {
  id        String   @id @default(cuid())
  title     String
  type      String   // PDF, VIDEO, LINK
  url       String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([teacherId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // SYSTEM, FEE, ALERT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Test {
  id        String   @id @default(cuid())
  title     String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  date      DateTime
  results   TestResult[]
}

model TestResult {
  id         String   @id @default(cuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation("StudentTestResults", fields: [studentId], references: [id], onDelete: Cascade)
  marks      Float
  totalMarks Float
  remarks    String?
  createdAt  DateTime @default(now())

  @@unique([testId, studentId])
  @@index([studentId])
}

model Attendance {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  status    String   // PRESENT, ABSENT, LATE
  
  @@unique([batchId, studentId, date])
  @@index([studentId])
}

model Lecture {
  id           String   @id @default(cuid())
  title        String
  description  String?
  youtubeUrl   String
  type         String   // LIVE or RECORDED
  subject      String
  batchId      String
  batch        Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assignedById String
  createdAt    DateTime @default(now())

  @@index([batchId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SalaryRecord {
  id            String   @id @default(cuid())
  teacherId     String
  teacher       User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  month         String   // e.g., "April 2026"
  baseSalary    Float
  bonus         Float    @default(0)
  deductions    Float    @default(0)
  netPaid       Float    @default(0)
  status        String   @default("PENDING") // PENDING, PAID
  paidAt        DateTime?
  transactionId String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([teacherId])
  @@index([status])
}

